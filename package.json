{
  "name": "steam-badge-unlocker",
  "version": "1.3.0",
  "description": "Completes the Steam Community Leader badge quests for bot accounts on top of a logged-in steamcommunity instance. API, requirements per quest and options: index.d.ts.",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "files": [
    "classes/",
    "components/",
    "resources/",
    "docs/",
    "examples/run-community-leader.js",
    "examples/utils/login-accounts.js",
    "examples/the-steam-awards-module.js",
    "index.js",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HenkerX64/node-steam-badge-unlocker.git"
  },
  "keywords": [
    "steam",
    "steam community",
    "steam badge",
    "steam tasks",
    "steam awards",
    "steam api",
    "community leader",
    "badge quests",
    "steamcommunity",
    "steam-user",
    "steam bot",
    "typescript"
  ],
  "author": "HenkerX64",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HenkerX64/node-steam-badge-unlocker/issues"
  },
  "homepage": "https://github.com/HenkerX64/node-steam-badge-unlocker",
  "devDependencies": {
    "@types/steamcommunity": "3.50.0",
    "mocha": "^8.4.0",
    "nyc": "14.1.1",
    "steam-user": "^5.0.0",
    "steamcommunity": "^3.49.0",
    "steam-totp": "^2.1.2",
    "steamid": ">=1.1.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "steam-user": ">=5.0.0",
    "steamcommunity": ">=3.43.1"
  },
  "peerDependenciesMeta": {
    "steam-user": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "scripts": {
    "test": "mocha tests/index.test.js --timeout 20000",
    "test-cov": "nyc mocha tests/index.test.js --timeout 20000",
    "test-types": "tsc -p tests/types && tsc -p tests/types/consumer-patterns && node tests/types/api-surface.js --check && node --test tests/types/parity.test.js",
    "test-types-floor": "npx -y -p typescript@4.0.5 tsc -p tests/types",
    "test-types-latest": "npx -y -p typescript@latest tsc -p tests/types/tsconfig.latest.json && npx -y -p typescript@latest tsc -p tests/types/consumer-patterns --module nodenext --moduleResolution nodenext && node tests/types/packed-consumer.js latest",
    "api-surface": "node tests/types/api-surface.js --write"
  }
}
